# App
APP_ENV=development
SECRET_KEY=your-jwt-secret-min-32-chars
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sellerbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Meta / Instagram
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=any-random-string-you-choose
META_API_VERSION=v19.0

# AI
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=sellerbot-uploads

# WhatsApp (owner pings + SMS forwarding)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Required before configuring Razorpay in /dashboard/commerce. Generate a Fernet
# key once, keep it in your secret manager, and back it up with database backups.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_ENCRYPTION_KEY=

# Customer WhatsApp Cloud API (separate from legacy owner pings)
CHANNEL_ENCRYPTION_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Required for Instagram signed webhooks. Never leave empty in a live deployment.
META_WEBHOOK_SECRET=
# Debug forwarding is opt-in; leave empty on production.
ROUTE_TO_LOCAL_SELLER_IDS=[]
